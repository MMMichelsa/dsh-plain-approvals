{
  "name": "dsh-plain-approvals",
  "version": "1.1.0",
  "description": "DSH plugin: plain-language approval cards with risk levels and file paths, plus plain-language question rewriting",
  "repository": {
    "type": "git",
    "url": "https://github.com/MMMichelsa/dsh-plain-approvals.git"
  },
  "homepage": "https://github.com/MMMichelsa/dsh-plain-approvals",
  "bugs": {
    "url": "https://github.com/MMMichelsa/dsh-plain-approvals/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "permissions",
    "accessibility",
    "plain-language"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "install.bat",
    "install.mjs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/index.test.mjs",
    "install-plugin": "node install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Michelsa",
  "license": "MIT"
}
